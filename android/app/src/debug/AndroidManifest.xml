<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: a keyboard the device tests type with, the way
     Gboard does (DictationTest). Off unless a test turns it on over adb. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <service
            android:name=".ScriptIme"
            android:enabled="false"
            android:exported="true"
            android:label="Gecko test keyboard"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/script_ime" />
        </service>
    </application>
</manifest>
