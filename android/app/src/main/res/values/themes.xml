<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Gecko" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/gecko_green_dark</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/gecko_green_dark</item>
    </style>

    <!-- The web UI paints itself; dark until its theme arrives. -->
    <style name="Theme.Gecko.Terminal" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/gecko_green</item>
        <item name="colorOnPrimary">@color/gecko_bg</item>
        <item name="android:windowBackground">@color/gecko_bg</item>
    </style>
</resources>
