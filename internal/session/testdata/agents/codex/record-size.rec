# The main states again at another size (phone or wide desktop tab).
wait 30 Trust this folder
sleep 500
dump trust-SIZE
keys "\r"
wait 10 Ask Codex
sleep 1000
dump idle-start-SIZE
type count slow please
keys "\r"
wait 5 esc to interrupt
dump working-SIZE
keys "\x1b"
wait 5 Conversation interrupted
sleep 1000
dump interrupted-SIZE
type list files here
keys "\r"
wait 10 Press enter to confirm
sleep 1500
dump approval-SIZE
keys "y"
wait 10 one file: a.txt(.|\n)*Worked for
sleep 1000
dump approved-SIZE
