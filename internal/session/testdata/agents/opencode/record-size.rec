# The main states again at another size (phone or wide desktop tab).
wait 60 Ask anything
sleep 1000
dump home-SIZE
type count slow please
keys "\r"
wait 5 [⬝■]{8}
dump working-SIZE
keys "\x1b"
sleep 300
keys "\x1b"
wait 5 interrupted
sleep 1000
dump interrupted-SIZE
type list files here
keys "\r"
wait 10 Permission required
sleep 1500
dump permission-SIZE
keys "\r"
wait 10 one file: a.txt
sleep 1500
dump approved-SIZE
type ask me something
keys "\r"
wait 10 Which color
sleep 1500
dump question-SIZE
