#!/bin/sh
set -e
if [ "${1:-}" = remove ] || [ "${1:-}" = purge ] || [ "${1:-}" = 0 ]; then
	if [ ! -f /etc/apparmor.d/gecko-desktop-package ] && command -v apparmor_parser >/dev/null 2>&1 &&
		[ -d /sys/kernel/security/apparmor ]; then
		printf 'profile gecko-desktop-package {}\n' | apparmor_parser -R 2>/dev/null || true
	fi
fi
exit 0
