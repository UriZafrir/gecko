#!/usr/bin/make -f
# Builds gecko (CLI and daemon) offline: the orig tarball has the Go modules
# vendored and the web client built (packaging/linux/source-tarball.sh), as
# Launchpad builders have no network. The Electron window (gecko-desktop) is
# not built here; see docs/linux-packages.md.
include /usr/share/dpkg/pkg-info.mk

# Ubuntu 24.04's default Go is 1.22.2; go.mod wants 1.22.5. golang-1.24-go
# is in noble-updates (and newer series, and Debian 13).
export PATH := /usr/lib/go-1.24/bin:$(PATH)
export CGO_ENABLED = 0
export GOFLAGS = -mod=vendor -trimpath
export GOPROXY = off
export GOTOOLCHAIN = local
export GOCACHE = $(CURDIR)/debian/.gocache
export HOME = $(CURDIR)/debian/.home

%:
	dh $@

override_dh_auto_build:
	go build -ldflags "-s -w -X main.version=$(DEB_VERSION_UPSTREAM)" -o debian/build/gecko ./cmd/gecko

override_dh_auto_test:
	debian/build/gecko version

override_dh_auto_install:
	install -Dm755 debian/build/gecko debian/gecko/usr/bin/gecko
	install -Dm644 packaging/linux/gecko.service debian/gecko/usr/lib/systemd/user/gecko.service
	mkdir -p debian/gecko/usr/share/applications
	sed 's|@BIN@|/usr/bin/gecko|' packaging/linux/gecko.desktop >debian/gecko/usr/share/applications/gecko.desktop
	install -Dm644 packaging/linux/gecko.svg debian/gecko/usr/share/icons/hicolor/scalable/apps/gecko.svg
	install -Dm644 packaging/linux/gecko-256.png debian/gecko/usr/share/icons/hicolor/256x256/apps/gecko.png
	install -Dm644 packaging/linux/gecko.metainfo.xml debian/gecko/usr/share/metainfo/dev.gecko.app.metainfo.xml

# Go binaries: no DWARF to compress, and the static binary is intended.
override_dh_dwz:

override_dh_auto_clean:
	rm -rf debian/build debian/.gocache debian/.home
